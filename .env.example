# Copy to .env for local development. Everything here is optional locally:
# with no file at all, the API uses an embedded Postgres (PGlite) and prints
# sign-in codes to the server log.

# ---- database -------------------------------------------------------------
# Unset  -> embedded PGlite, persisted in apps/api/.pglite (no install needed)
# Set    -> a real Postgres, e.g. the Internal Database URL from Render
# DATABASE_URL=postgresql://user:password@host:5432/portal

# PGLITE_DIR=.pglite

# ---- auth -----------------------------------------------------------------
# Must be >= 32 chars in production.
# BETTER_AUTH_SECRET=dev-only-secret-not-for-production-use-0123456789

# The public URL of the API itself. Cookies are issued for this origin.
# BETTER_AUTH_URL=http://localhost:8787

# Comma-separated origins allowed to call the API with credentials.
# TRUSTED_ORIGINS=http://localhost:5173

# ---- email ----------------------------------------------------------------
# With no key set, codes are logged instead of emailed, so the whole flow works
# with zero third-party signup. In production an HTTPS email API is required:
# Render blocks outbound SMTP (port 25 always; 465/587 on free instances).
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM="Portal <login@yourdomain.com>"

# ---- runtime --------------------------------------------------------------
# PORT=8787
# RUN_MIGRATIONS_ON_BOOT=1
